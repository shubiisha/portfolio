/* -----------------------------
   Design tokens
----------------------------- */
:root {
  --bg: #f5f7fb;
  --panel: #ffffff;
  --panel-alt: #eef3ff;
  --panel-soft: #f3f6fb;
  --text: #0f172a;
  --text-soft: #475569;
  --muted: #64748b;
  --line: rgba(15, 23, 42, 0.08);
  --line-strong: rgba(15, 23, 42, 0.15);
  --primary: #0f172a;
  --primary-hover: #111827;
  --accent: #2563eb;
  --green: #10b981;
  --green-soft: rgba(16, 185, 129, 0.12);
  --shadow-sm: 0 10px 30px rgba(15, 23, 42, 0.06);
  --shadow-md: 0 18px 45px rgba(15, 23, 42, 0.08);
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --container: 1180px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
img { display: block; max-width: 100%; }
a { text-decoration: none; color: inherit; }
button, input, textarea { font: inherit; }
h1, h2, h3, h4 { margin: 0; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; letter-spacing: -0.03em; }
p { margin: 0; }
:focus-visible { outline: 3px solid rgba(37, 99, 235, 0.45); outline-offset: 2px; }
.svg-icon { width: 18px; height: 18px; vertical-align: middle; fill: currentColor; }

.site-header {
  position: sticky; top: 0; z-index: 1100;
  background: rgba(245, 247, 251, 0.8);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  transition: box-shadow 0.3s ease, background 0.3s ease;
}
.site-header.scrolled { background: rgba(255,255,255,0.92); box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05); }

.nav-container, .section-container, .footer-container {
  width: min(var(--container), calc(100% - 32px));
  margin: 0 auto;
}

.nav-container {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 76px; gap: 24px;
}
.brand-logo { display: inline-flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.1rem; }
.brand-logo-img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line-strong); }
.brand-logo-text { letter-spacing: -0.04em; }
.brand-logo-text span { color: var(--accent); }

.nav-links {
  display: flex; align-items: center; gap: 18px; list-style: none; margin: 0; padding: 0;
}
.nav-links a {
  position: relative; padding: 8px 12px; color: var(--text-soft); font-weight: 600; font-size: 0.94rem; transition: color 0.2s ease;
}
.nav-links a:hover, .nav-links a.active { color: var(--text); }
.nav-links a::after {
  content: ""; position: absolute; left: 12px; right: 12px; bottom: 0; height: 2px; background: var(--accent); border-radius: 99px; transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease;
}
.nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }
.nav-btn { background: var(--primary); color: #fff !important; border-radius: 12px; box-shadow: var(--shadow-sm); border: 1px solid transparent; }
.nav-btn::after { display: none; }
.mobile-toggle { display: none; background: transparent; border: 1px solid var(--line-strong); width: 42px; height: 42px; border-radius: 12px; font-size: 1.3rem; cursor: pointer; color: var(--text); }

.hero-section { padding: 62px 0 54px; }
.hero-container {
  width: min(var(--container), calc(100% - 32px)); margin: 0 auto;
  display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 54px; align-items: center;
}
.hero-badge-container {
  display: inline-flex; align-items: center; gap: 10px; padding: 9px 14px; border-radius: 999px;
  background: var(--green-soft); border: 1px solid rgba(16, 185, 129, 0.18); color: #065f46; font-size: 0.8rem; font-weight: 700; margin-bottom: 18px;
}
.hero-badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 7px rgba(16, 185, 129, 0.12); }
.hero-title { font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: 1.06; letter-spacing: -0.055em; margin-bottom: 12px; }
.hero-subtitle { min-height: 36px; font-size: clamp(1.05rem, 2vw, 1.5rem); color: var(--accent); font-weight: 700; margin-bottom: 16px; }
.hero-description { max-width: 640px; color: var(--text-soft); font-size: 1.03rem; line-height: 1.8; margin-bottom: 26px; }
.hero-social-links { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
.social-pill {
  display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px;
  background: rgba(255,255,255,0.7); border: 1px solid var(--line); color: var(--text-soft); font-size: 0.88rem; font-weight: 600; transition: transform 0.2s ease, border-color 0.2s ease;
}
.social-pill:hover { transform: translateY(-1px); border-color: var(--line-strong); }

.hero-cta-group { display: flex; flex-wrap: wrap; gap: 14px; }
.btn-primary, .btn-secondary, .card-btn-demo, .card-btn-details, .form-submit-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid transparent; border-radius: 12px; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.btn-primary, .card-btn-demo, .form-submit-btn { background: var(--primary); color: #fff; box-shadow: var(--shadow-sm); }
.btn-primary, .btn-secondary { min-height: 48px; padding: 0 20px; font-weight: 700; font-size: 0.96rem; }
.btn-secondary, .card-btn-details { background: rgba(255,255,255,0.8); border-color: var(--line-strong); color: var(--text); }
.btn-primary:hover, .btn-secondary:hover, .card-btn-demo:hover, .card-btn-details:hover, .form-submit-btn:hover { transform: translateY(-1px); }

.hero-card-wrapper { display: flex; justify-content: center; }
.hero-profile-card {
  width: min(100%, 370px); background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(238,243,255,0.85));
  border: 1px solid var(--line); border-radius: var(--radius-xl); box-shadow: var(--shadow-md); padding: 28px 22px 24px; text-align: center;
}
.hero-avatar-container { position: relative; width: 120px; height: 120px; margin: 0 auto 18px; }
.hero-avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.9); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12); }
.hero-avatar-badge { position: absolute; right: 6px; bottom: 6px; width: 26px; height: 26px; border-radius: 50%; background: var(--green); border: 3px solid #fff; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 0.8rem; }
.hero-card-name { font-size: 1.7rem; margin-bottom: 4px; }
.hero-card-role { color: var(--muted); font-size: 0.95rem; font-weight: 600; margin-bottom: 18px; }
.hero-card-chips { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
.tech-chip { padding: 7px 10px; border-radius: 999px; background: rgba(255,255,255,0.75); border: 1px solid var(--line); color: var(--text-soft); font-size: 0.72rem; font-weight: 700; }

.hero-stats-bar {
  width: min(var(--container), calc(100% - 32px)); margin: 42px auto 0; display: grid; grid-template-columns: repeat(4, minmax(180px, 1fr)); gap: 16px; padding-top: 28px; border-top: 1px solid var(--line);
}
.stat-item { background: rgba(255,255,255,0.7); border: 1px solid var(--line); border-radius: 16px; padding: 18px 14px; text-align: center; }
.stat-number { font-size: clamp(1.4rem, 2vw, 1.9rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 5px; }
.stat-label { font-size: 0.8rem; color: var(--muted); font-weight: 600; }

.section { padding: 88px 0; }
.section-header { max-width: 700px; margin: 0 auto 42px; text-align: center; }
.section-label { display: inline-block; margin-bottom: 12px; color: var(--accent); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
.section-header h2 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.14; letter-spacing: -0.05em; margin-bottom: 12px; }
.section-header p { color: var(--text-soft); font-size: 1rem; line-height: 1.8; }

.about-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 26px; align-items: flex-start; }
.about-card, .contact-form-card, .github-card, .project-showcase-card, .info-badge-card { background: rgba(255,255,255,0.8); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
.about-card { padding: 28px; }
.about-card h3 { font-size: 1.7rem; margin-bottom: 16px; }
.about-card p { color: var(--text-soft); line-height: 1.8; margin-bottom: 16px; }
.about-highlights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 18px; }
.highlight-box { background: var(--panel-soft); border: 1px solid var(--line); border-radius: 16px; padding: 18px 16px; }
.highlight-box h4 { font-size: 1rem; margin-bottom: 6px; }
.highlight-box p { margin: 0; font-size: 0.88rem; }
.about-side-cards { display: grid; gap: 16px; }
.info-badge-card { display: flex; align-items: flex-start; gap: 16px; padding: 20px; }
.info-badge-icon { width: 46px; height: 46px; border-radius: 14px; background: var(--panel-alt); border: 1px solid var(--line); display: grid; place-items: center; font-size: 1.25rem; }
.info-badge-card h4 { margin-bottom: 5px; font-size: 1.06rem; }
.info-badge-card p { color: var(--text-soft); line-height: 1.65; font-size: 0.9rem; }

.skills-section { background: linear-gradient(180deg, rgba(238,243,255,0.35), rgba(245,247,251,0)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.skill-filters { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
.filter-btn {
  background: rgba(255,255,255,0.9); border: 1px solid var(--line); color: var(--text-soft); border-radius: 999px; padding: 10px 16px; cursor: pointer; font-weight: 700; transition: all 0.2s ease;
}
.filter-btn:hover, .filter-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
.skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; }
.skill-card-modern { display: flex; align-items: center; gap: 14px; background: rgba(255,255,255,0.8); border: 1px solid var(--line); border-radius: 16px; padding: 18px 16px; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
.skill-card-modern:hover { transform: translateY(-2px); border-color: rgba(37, 99, 235, 0.3); box-shadow: var(--shadow-sm); }
.skill-icon-wrap { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: var(--panel-alt); border: 1px solid var(--line); font-size: 1.3rem; }
.skill-info { min-width: 0; }
.skill-name { font-weight: 700; font-size: 0.98rem; margin-bottom: 4px; }
.skill-category-tag { color: var(--muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

.projects-showcase-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
.project-showcase-card { overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
.project-showcase-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.project-card-header-visual { position: relative; display: grid; place-items: center; height: 170px; border-bottom: 1px solid var(--line); }
.p1-bg { background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(37, 99, 235, 0.06)); }
.p2-bg { background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(14, 165, 233, 0.06)); }
.p3-bg { background: linear-gradient(135deg, rgba(168, 85, 247, 0.12), rgba(244, 114, 182, 0.08)); }
.project-card-icon-big { font-size: 4rem; }
.project-card-badge { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,0.92); border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
.project-showcase-body { padding: 22px 20px 18px; }
.project-meta-type { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
.project-card-title { font-size: 1.42rem; margin-bottom: 10px; }
.project-card-desc { color: var(--text-soft); line-height: 1.75; font-size: 0.96rem; margin-bottom: 16px; }
.project-tech-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.tech-tag { display: inline-flex; align-items: center; background: var(--panel-soft); border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; color: var(--text-soft); font-size: 0.72rem; font-weight: 700; }
.project-card-actions-center { display: flex; gap: 10px; margin-bottom: 14px; }
.card-btn-demo, .card-btn-details { flex: 1; min-height: 42px; padding: 0 12px; font-weight: 700; font-size: 0.88rem; }
.project-card-link { color: var(--primary); font-weight: 700; font-size: 0.92rem; }

.github-section { background: rgba(255,255,255,0.4); }
.github-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.github-card { padding: 22px 20px 18px; }
.repo-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.repo-icon { font-size: 1.2rem; }
.repo-header a { font-size: 1.08rem; font-weight: 800; }
.github-card p { color: var(--text-soft); line-height: 1.7; margin-bottom: 16px; }
.repo-meta { display: flex; flex-wrap: wrap; gap: 8px; }
.repo-meta span { background: var(--panel-soft); border: 1px solid var(--line); border-radius: 999px; padding: 6px 9px; color: var(--text-soft); font-size: 0.72rem; font-weight: 700; }

.contact-layout { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 26px; align-items: stretch; }
.contact-info-col { background: rgba(255,255,255,0.8); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 28px 22px; }
.contact-info-col h3 { font-size: 1.8rem; margin-bottom: 10px; }
.contact-info-col p { color: var(--text-soft); line-height: 1.8; margin-bottom: 18px; }
.contact-channels { display: grid; gap: 14px; }
.contact-channel-card { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 14px; border-radius: 16px; border: 1px solid var(--line); background: rgba(245,247,251,0.8); transition: transform 0.2s ease, border-color 0.2s ease; }
.contact-channel-card:hover { transform: translateY(-1px); border-color: var(--line-strong); }
.channel-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #fff; border: 1px solid var(--line); font-size: 1.2rem; }
.channel-details h4 { margin-bottom: 4px; font-size: 1rem; }
.channel-details span { color: var(--text-soft); font-size: 0.9rem; }

.contact-form-card { padding: 26px 22px; }
#contactForm { display: grid; gap: 18px; }
.form-group { display: grid; gap: 8px; }
.form-group label { font-weight: 700; font-size: 0.9rem; }
.form-group input, .form-group textarea {
  width: 100%; border: 1px solid var(--line-strong); border-radius: 12px; background: rgba(255,255,255,0.8); color: var(--text); padding: 12px 14px; resize: vertical; transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.form-group input:focus, .form-group textarea:focus { border-color: rgba(37,99,235,0.45); box-shadow: 0 0 0 3px rgba(37,99,235,0.10); outline: none; }
.form-submit-btn { width: 100%; min-height: 50px; font-weight: 800; }
.form-status-msg { min-height: 22px; font-size: 0.92rem; font-weight: 600; color: var(--text-soft); }
.form-status-msg.error { color: #b91c1c; }
.form-status-msg.success { color: #065f46; }

.site-footer { background: #0f172a; color: rgba(255,255,255,0.9); padding: 28px 0 20px; }
.footer-container { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
.footer-logo { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.05em; }
.footer-logo span { color: #7dd3fc; }
.footer-tagline { margin-top: 6px; color: rgba(255,255,255,0.72); font-size: 0.9rem; }
.footer-links { display: flex; flex-wrap: wrap; gap: 18px; list-style: none; padding: 0; margin: 0; }
.footer-links a { color: rgba(255,255,255,0.76); transition: color 0.2s ease; }
.footer-links a:hover { color: #fff; }
.footer-bottom {
  width: min(var(--container), calc(100% - 32px)); margin: 18px auto 0; padding-top: 18px; border-top: 1px solid rgba(255,255,255,0.12);
  display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: rgba(255,255,255,0.72); font-size: 0.9rem;
}
.back-to-top-btn { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #fff; border-radius: 12px; padding: 10px 14px; cursor: pointer; }

@media (max-width: 980px) {
  .hero-container, .about-grid, .contact-layout, .projects-showcase-grid, .github-grid { grid-template-columns: 1fr; }
  .hero-container { gap: 32px; }
  .hero-stats-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 760px) {
  .mobile-toggle { display: inline-flex; align-items: center; justify-content: center; }
  .nav-links {
    position: absolute; top: 76px; left: 16px; right: 16px; display: none; flex-direction: column; align-items: stretch; padding: 18px; border: 1px solid var(--line); background: rgba(255,255,255,0.96); border-radius: 18px; box-shadow: var(--shadow-md);
  }
  .nav-links.open { display: flex; }
  .nav-links a { width: 100%; text-align: center; padding: 10px 12px; }
  .nav-btn { width: 100%; }
  .hero-badge-container { width: 100%; justify-content: center; }
  .hero-cta-group { flex-direction: column; align-items: stretch; }
  .btn-primary, .btn-secondary { width: 100%; }
  .about-highlights { grid-template-columns: 1fr; }
  .hero-stats-bar { grid-template-columns: 1fr; }
  .project-card-actions-center { flex-direction: column; }
  .card-btn-demo, .card-btn-details { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
