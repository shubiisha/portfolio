<%- include('partials/head') %>

<%- include('partials/nav') %>

<main id="main">
  <!-- ---------------------------------------------------------------- hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="status-pill"><span class="status-dot" aria-hidden="true"></span><%= site.profile.availability %></p>

        <h1>
          <%= site.profile.name %>
          <span><%= site.profile.role %> · building for the web, end to end.</span>
        </h1>

        <p class="hero__role" aria-live="polite">
          <span id="typedRole"><%= site.profile.roles[0] %></span><span class="caret" aria-hidden="true"></span>
        </p>

        <p class="hero__intro"><%= site.profile.intro %></p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#projects">
            <%- h.icon('layers', 17) %> <span class="btn__label">View my projects</span>
          </a>
          <a class="btn btn--ghost" href="<%= site.profile.resume.file %>" download>
            <%- h.icon('download', 17) %> <span class="btn__label">Download resume</span>
          </a>
          <a class="btn btn--ghost" href="#contact">
            <%- h.icon('mail', 17) %> <span class="btn__label">Contact me</span>
          </a>
        </div>

        <div class="hero__meta">
          <span><%- h.icon('pin', 15) %> <%= site.profile.location %></span>
          <span><%- h.icon('cap', 15) %> <%= site.profile.education.degree %></span>
          <span><%- h.icon('star', 15) %> <%= site.profile.interests[0] %></span>
        </div>
      </div>

      <div class="hero__visual">
        <figure class="portrait">
          <img
            src="/assets/profile.jpg"
            width="372"
            height="465"
            alt="Portrait of <%= site.profile.name %>"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="portrait__tag">
            <div>
              <strong><%= site.profile.name %></strong>
              <%= site.profile.role %>
            </div>
            <span>India</span>
          </figcaption>
        </figure>

        <div class="float-card float-card--1" aria-hidden="true"><%- h.icon('code', 16) %> React · Node · MySQL</div>
        <div class="float-card float-card--2" aria-hidden="true"><%- h.icon('shield', 16) %> REST APIs &amp; auth</div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- stack strip -->
  <div class="strip" aria-hidden="true">
    <div class="container strip__inner">
      <span class="strip__label">Working stack</span>
      <div class="strip__track">
        <% const stripItems = ['JavaScript', 'React.js', 'Node.js', 'Express.js', 'MySQL', 'MongoDB', 'Python', 'Java', 'Git & GitHub', 'REST APIs', 'AWS', 'Firebase']; %>
        <% for (let pass = 0; pass < 2; pass++) { %>
          <% stripItems.forEach(function (item) { %><span><%= item %> ·</span><% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ---------------------------------------------------------------- stats -->
  <section class="section section--tight">
    <div class="container">
      <div class="stats reveal">
        <% site.stats.forEach(function (stat) { %>
          <div class="stat">
            <div class="stat__value"><%= stat.value %></div>
            <div class="stat__label"><%= stat.label %></div>
            <div class="stat__detail"><%= stat.detail %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- about -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head__text">
          <p class="eyebrow">About me</p>
          <h2 class="section-title">A developer who finishes what the schema starts.</h2>
        </div>
        <p class="section-sub">
          Computer Science &amp; Engineering student, full-stack builder, and someone who would rather ship a small
          working slice than a large unfinished plan.
        </p>
      </div>

      <div class="about">
        <div class="reveal">
          <div class="about__body">
            <% site.profile.about.forEach(function (paragraph) { %><p><%= paragraph %></p><% }); %>
          </div>

          <div class="strength-list">
            <% site.profile.strengths.forEach(function (item) { %>
              <div class="strength">
                <%- h.icon('check', 17) %>
                <div>
                  <strong><%= item.title %></strong>
                  <p><%= item.text %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="about__aside reveal">
          <div class="card">
            <div class="card__head"><%- h.icon('cap', 17) %><h3>Education</h3></div>
            <p class="edu__degree"><%= site.profile.education.degree %></p>
            <p class="edu__meta"><%= site.profile.education.status %></p>
            <div class="chip-row">
              <% site.profile.education.focus.forEach(function (item) { %><span class="chip"><%= item %></span><% }); %>
            </div>
          </div>

          <div class="card">
            <div class="card__head"><%- h.icon('briefcase', 17) %><h3>Career objective</h3></div>
            <p class="about__body" style="font-size: 0.9rem;"><%= site.profile.objective %></p>
          </div>

          <div class="card">
            <div class="card__head"><%- h.icon('spark', 17) %><h3>How I work</h3></div>
            <ul class="checklist">
              <% site.profile.approach.forEach(function (item) { %><li><%= item %></li><% }); %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- skills -->
  <section class="section section--surface" id="skills">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head__text">
          <p class="eyebrow">Technical skills</p>
          <h2 class="section-title">The tools I actually use.</h2>
        </div>
        <p class="section-sub">
          Grouped by where they sit in a project — from the language I reach for first to the infrastructure the app
          runs on.
        </p>
      </div>

      <div class="skills-grid">
        <% site.skillGroups.forEach(function (group) { %>
          <article class="skill-card reveal">
            <div class="skill-card__head">
              <span class="skill-card__icon" aria-hidden="true"><%- h.icon(group.icon === 'tool' ? 'wrench' : group.icon, 18) %></span>
              <div>
                <h3><%= group.title %></h3>
                <p class="skill-card__summary"><%= group.summary %></p>
              </div>
            </div>
            <ul class="skill-list">
              <% group.skills.forEach(function (skill) { %>
                <li><span><%= skill.name %></span><span><%= skill.note %></span></li>
              <% }); %>
            </ul>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- projects -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head__text">
          <p class="eyebrow">Selected work</p>
          <h2 class="section-title">Projects, with the problem they solve.</h2>
        </div>
        <p class="section-sub">
          <%= site.projects.length %> documented projects. Every repository link below is real; live demos appear only
          where a working deployment exists.
        </p>
      </div>

      <div class="filters reveal" role="group" aria-label="Filter projects by category">
        <% site.projectCategories.forEach(function (category) { %>
          <% const count = category.id === 'all' ? site.projects.length : site.projects.filter(function (p) { return p.category === category.id; }).length; %>
          <button
            class="filter"
            type="button"
            data-filter="<%= category.id %>"
            aria-pressed="<%= category.id === 'all' ? 'true' : 'false' %>"
          >
            <%= category.label %><span class="filter__count"><%= count %></span>
          </button>
        <% }); %>
      </div>

      <div class="projects-grid" id="projectGrid">
        <% site.projects.forEach(function (project) { %>
          <article class="project-card reveal" data-category="<%= project.category %>">
            <div class="project-card__media">
              <img
                src="<%= project.cover %>"
                alt="<%= project.title %> — project cover"
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
              />
              <div class="project-card__badges">
                <span class="badge"><%= project.year %></span>
                <% if (project.demo) { %>
                  <span class="badge badge--live"><%- h.icon('check', 11) %> Live</span>
                <% } else { %>
                  <span class="badge">Source only</span>
                <% } %>
              </div>
            </div>

            <div class="project-card__body">
              <h3 class="project-card__title">
                <a href="/projects/<%= project.slug %>"><%= project.title %></a>
              </h3>
              <p class="project-card__sub"><%= project.subtitle %></p>
              <p class="project-card__summary"><%= project.summary %></p>

              <div class="project-card__stack">
                <% project.stack.slice(0, 5).forEach(function (tech) { %><span class="chip"><%= tech %></span><% }); %>
              </div>

              <div class="project-card__actions">
                <a class="icon-btn" href="<%= project.repo %>" target="_blank" rel="noopener noreferrer">
                  <%- h.icon('github', 14) %> GitHub<span class="sr-only"> repository for <%= project.title %></span>
                </a>
                <% if (project.demo) { %>
                  <a class="icon-btn" href="<%= project.demo %>" target="_blank" rel="noopener noreferrer">
                    <%- h.icon('external', 14) %> Live demo<span class="sr-only"> for <%= project.title %></span>
                  </a>
                <% } %>
                <a class="link-arrow" href="/projects/<%= project.slug %>">Case study <%- h.icon('arrow', 15) %></a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>

      <p class="projects-note">
        Projects without a live demo are marked “Source only” — the code is public on GitHub, and a demo link is added
        only once a deployment is verified.
      </p>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- github -->
  <section class="section section--surface" id="github">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head__text">
          <p class="eyebrow">Open source</p>
          <h2 class="section-title">Code on GitHub.</h2>
        </div>
        <p class="section-sub">
          Public repositories, live from the GitHub REST API. If the API is unavailable the section falls back to a
          recorded snapshot instead of inventing numbers.
        </p>
      </div>

      <div class="github-layout">
        <aside class="card gh-profile reveal">
          <div class="gh-profile__top">
            <img
              class="gh-avatar"
              src="<%= github.profile.avatar || '/assets/profile.jpg' %>"
              alt="GitHub avatar of <%= github.profile.login %>"
              width="54"
              height="54"
              loading="lazy"
            />
            <div>
              <h3><%= github.profile.name || github.profile.login %></h3>
              <p class="gh-profile__handle">@<%= github.profile.login %></p>
            </div>
          </div>

          <% if (github.profile.bio) { %><p class="gh-profile__bio"><%= github.profile.bio %></p><% } %>

          <div class="gh-figs">
            <div class="gh-fig">
              <div class="gh-fig__value"><%= github.profile.publicRepos %></div>
              <div class="gh-fig__label">Public repos</div>
            </div>
            <div class="gh-fig">
              <div class="gh-fig__value"><%= typeof github.profile.followers === 'number' ? github.profile.followers : '—' %></div>
              <div class="gh-fig__label">Followers</div>
            </div>
          </div>

          <% if (github.languages && github.languages.length) { %>
            <div class="lang-bars">
              <% github.languages.forEach(function (lang) { %>
                <% const share = Math.round((lang.count / github.languages.reduce(function (sum, item) { return sum + item.count; }, 0)) * 100); %>
                <div>
                  <div class="lang-bar__head"><span><%= lang.name %></span><span><%= share %>%</span></div>
                  <div class="lang-bar__track">
                    <div class="lang-bar__fill" style="width: <%= share %>%; background: <%= lang.color %>;"></div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>

          <a class="btn btn--ghost btn--block" style="margin-top: 20px;" href="<%= site.profile.github %>" target="_blank" rel="noopener noreferrer">
            <%- h.icon('github', 16) %> <span class="btn__label">Open GitHub profile</span>
          </a>

          <p class="source-note">
            <%- h.icon('terminal', 14) %>
            <% if (github.available) { %>
              Live data from the GitHub API.
            <% } else { %>
              API unavailable — showing the last verified snapshot.
            <% } %>
          </p>
        </aside>

        <div class="reveal">
          <div class="gh-repos">
            <% github.repos.slice(0, 6).forEach(function (repo) { %>
              <a class="repo" href="<%= repo.url %>" target="_blank" rel="noopener noreferrer">
                <span class="repo__name"><%- h.icon('github', 14) %> <%= repo.name %></span>
                <span class="repo__meta">
                  <span><span class="lang-dot" style="background: <%= repo.languageColor %>;"></span><%= repo.language %></span>
                  <% if (repo.stars) { %><span><%- h.icon('star', 12) %> <%= repo.stars %></span><% } %>
                  <% if (repo.homepage) { %><span><%- h.icon('external', 12) %> Deployed</span><% } %>
                </span>
                <% if (repo.description) { %><span class="repo__desc"><%= repo.description %></span><% } %>
              </a>
            <% }); %>
          </div>

          <% if (!github.available) { %>
            <p class="source-note">
              <%- h.icon('alert', 14) %>
              GitHub could not be reached right now. Repository links above still point to the public profile.
            </p>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- contact -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-layout">
        <div class="reveal">
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Let’s talk about the role.</h2>
          <p class="section-sub" style="margin-top: 14px;">
            I’m looking for an internship or entry-level software development position. Send a message with the role,
            the team, or the problem you need solved — I reply personally.
          </p>

          <div class="contact-list">
            <a class="contact-item" href="mailto:<%= site.profile.email %>?subject=Hello%20<%= encodeURIComponent(site.profile.name) %>">
              <span class="contact-item__icon" aria-hidden="true"><%- h.icon('mail', 17) %></span>
              <span>
                <span class="contact-item__label">Email</span>
                <span class="contact-item__value"><%= site.profile.email %></span>
              </span>
              <span class="contact-item__arrow" aria-hidden="true"><%- h.icon('arrow', 15) %></span>
            </a>

            <a class="contact-item" href="<%= site.profile.github %>" target="_blank" rel="noopener noreferrer">
              <span class="contact-item__icon" aria-hidden="true"><%- h.icon('github', 17) %></span>
              <span>
                <span class="contact-item__label">GitHub</span>
                <span class="contact-item__value">github.com/<%= site.profile.githubUser %></span>
              </span>
              <span class="contact-item__arrow" aria-hidden="true"><%- h.icon('external', 15) %></span>
            </a>

            <% if (site.profile.linkedin) { %>
              <a class="contact-item" href="<%= site.profile.linkedin %>" target="_blank" rel="noopener noreferrer">
                <span class="contact-item__icon" aria-hidden="true"><%- h.icon('linkedin', 17) %></span>
                <span>
                  <span class="contact-item__label">LinkedIn</span>
                  <span class="contact-item__value">Professional profile</span>
                </span>
                <span class="contact-item__arrow" aria-hidden="true"><%- h.icon('external', 15) %></span>
              </a>
            <% } else { %>
              <div class="contact-item contact-item--static">
                <span class="contact-item__icon" aria-hidden="true"><%- h.icon('linkedin', 17) %></span>
                <span>
                  <span class="contact-item__label">LinkedIn</span>
                  <span class="contact-item__value">Link added once the profile URL is confirmed</span>
                </span>
              </div>
            <% } %>

            <div class="contact-item contact-item--static">
              <span class="contact-item__icon" aria-hidden="true"><%- h.icon('pin', 17) %></span>
              <span>
                <span class="contact-item__label">Location</span>
                <span class="contact-item__value"><%= site.profile.location %></span>
              </span>
            </div>
          </div>
        </div>

        <div class="form-card reveal">
          <div class="form-card__head">
            <h3>Send a message</h3>
            <p>All fields are required. Your message is delivered straight to my inbox.</p>
          </div>

          <form id="contactForm" novalidate>
            <div class="field-grid">
              <div class="field">
                <label for="name">Full name <span class="req" aria-hidden="true">*</span></label>
                <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required aria-describedby="name-error" />
                <p class="error-text" id="name-error" role="alert"></p>
              </div>

              <div class="field">
                <label for="email">Email address <span class="req" aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required aria-describedby="email-error" />
                <p class="error-text" id="email-error" role="alert"></p>
              </div>

              <div class="field field--full">
                <label for="subject">Subject <span class="req" aria-hidden="true">*</span></label>
                <input id="subject" name="subject" type="text" placeholder="Internship opportunity, project question…" required aria-describedby="subject-error" />
                <p class="error-text" id="subject-error" role="alert"></p>
              </div>

              <div class="field field--full">
                <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
                <textarea id="message" name="message" rows="5" placeholder="Tell me about the role or what you'd like to discuss…" required aria-describedby="message-error"></textarea>
                <p class="error-text" id="message-error" role="alert"></p>
              </div>

              <div class="hp-field" aria-hidden="true">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>
            </div>

            <div class="form-foot">
              <button class="btn btn--primary" type="submit" id="submitBtn">
                <span class="spinner" aria-hidden="true"></span>
                <%- h.icon('send', 16) %>
                <span class="btn__label">Send message</span>
              </button>
              <p class="form-hint">Sent over HTTPS. No third-party analytics, no tracking.</p>
            </div>

            <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>

            <% if (!contact.configured) { %>
              <p class="config-note">
                <%- h.icon('alert', 15) %>
                <span>
                  Email delivery is not configured on this deployment yet. Until
                  <code>RESEND_API_KEY</code> (or <code>SMTP_HOST</code>, <code>SMTP_USER</code>,
                  <code>SMTP_PASS</code>) is set, the form reports the real failure below and the
                  <a href="mailto:<%= site.profile.email %>">direct email link</a> still works.
                </span>
              </p>
            <% } %>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<script src="/js/site.js" defer></script>
</body>
</html>
